# Default model to load at startup
DEFAULT_MODEL=microsoft/Florence-2-large

# Host and port
HOST=0.0.0.0
PORT=7860

# Set to "true" to serve the React build from FastAPI (production mode)
SERVE_STATIC=true
STATIC_DIR=../frontend/dist

# CORS origins (comma-separated, use * for all)
CORS_ORIGINS=*

# Optional: override where HuggingFace downloads model weights
# MODEL_CACHE_DIR=/data/hf_cache

# Optional: override torch dtype (float16 | bfloat16 | float32)
# TORCH_DTYPE=float16
